generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================================
// AUTH / RBAC
// ==========================================================

enum RoleName {
  SUPER_ADMIN
  ADMIN
  MANAGER
  AGENT
  ACCOUNTANT
}

model Role {
  id          String           @id @default(uuid())
  name        RoleName         @unique
  label       String
  description String?
  permissions RolePermission[]
  users       Profile[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id        String           @id @default(uuid())
  key       String           @unique // ex: clients.view
  module    String
  label     String
  roles     RolePermission[]
  createdAt DateTime         @default(now())
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String

  @@unique([roleId, permissionId])
}

enum ProfileStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Profile {
  id            String        @id @default(uuid())
  firstName     String
  lastName      String
  email         String        @unique
  passwordHash  String
  phone         String?
  avatarUrl     String?
  role          Role          @relation(fields: [roleId], references: [id])
  roleId        String
  status        ProfileStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  sessions        Session[]
  assignedRequests Request[]  @relation("RequestAssignee")
  assignedOrders   Order[]    @relation("OrderAssignee")
  assignedTasks    Task[]     @relation("TaskAssignee")
  auditLogs        AuditLog[]
  notifications    Notification[]
  uploadedDocuments Document[] @relation("DocumentUploadedBy")
  messagesSent      Message[]  @relation("MessageSender")
  conversationParticipants ConversationParticipant[]
}

model Session {
  id        String   @id @default(uuid())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  tokenHash String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

// ==========================================================
// CLIENTS
// ==========================================================

enum ClientStatus {
  ACTIVE
  INACTIVE
}

model Client {
  id           String       @id @default(uuid())
  firstName    String
  lastName     String
  company      String?
  email        String?
  phone        String?
  whatsapp     String?
  address      String?
  country      String?
  city         String?
  status       ClientStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  requests     Request[]
  orders       Order[]
  payments     Payment[]
  invoices     Invoice[]
  documents    Document[]
  tasks        Task[]
  conversations Conversation[]

  @@index([email])
  @@index([status])
}

// ==========================================================
// SERVICES
// ==========================================================

model ServiceCategory {
  id       String    @id @default(uuid())
  name     String    @unique
  services Service[]
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

model Service {
  id          String          @id @default(uuid())
  name        String
  description String?
  price       Decimal         @default(0) @db.Decimal(12, 2)
  category    ServiceCategory? @relation(fields: [categoryId], references: [id])
  categoryId  String?
  imageUrl    String?
  status      ServiceStatus   @default(ACTIVE)
  steps       Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  requests    Request[]
  orderItems  OrderItem[]

  @@index([status])
}

// ==========================================================
// DEMANDES
// ==========================================================

enum RequestStatus {
  NEW
  REVIEWING
  APPROVED
  IN_PROGRESS
  WAITING_CLIENT
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Request {
  id          String        @id @default(uuid())
  number      String        @unique
  client      Client        @relation(fields: [clientId], references: [id])
  clientId    String
  service     Service       @relation(fields: [serviceId], references: [id])
  serviceId   String
  description String?
  status      RequestStatus @default(NEW)
  priority    Priority      @default(MEDIUM)
  assignee    Profile?      @relation("RequestAssignee", fields: [assigneeId], references: [id])
  assigneeId  String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  documents   Document[]
  history     RequestHistory[]
  order       Order?

  @@index([status])
  @@index([clientId])
}

model RequestHistory {
  id        String   @id @default(uuid())
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
  status    RequestStatus
  note      String?
  createdAt DateTime @default(now())
}

// ==========================================================
// COMMANDES / DOSSIERS
// ==========================================================

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  WAITING_PAYMENT
  WAITING_CLIENT
  COMPLETED
  CANCELLED
}

model Order {
  id           String      @id @default(uuid())
  number       String      @unique
  client       Client      @relation(fields: [clientId], references: [id])
  clientId     String
  request      Request?    @relation(fields: [requestId], references: [id])
  requestId    String?     @unique
  amount       Decimal     @default(0) @db.Decimal(12, 2)
  amountPaid   Decimal     @default(0) @db.Decimal(12, 2)
  status       OrderStatus @default(PENDING)
  assignee     Profile?    @relation("OrderAssignee", fields: [assigneeId], references: [id])
  assigneeId   String?
  dueDate      DateTime?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  items        OrderItem[]
  payments     Payment[]
  invoices     Invoice[]
  documents    Document[]
  tasks        Task[]
  history      OrderHistory[]

  @@index([status])
  @@index([clientId])
}

model OrderItem {
  id        String  @id @default(uuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  service   Service @relation(fields: [serviceId], references: [id])
  serviceId String
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 2)
}

model OrderHistory {
  id        String      @id @default(uuid())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}

// ==========================================================
// PAIEMENTS / FACTURES
// ==========================================================

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MONCASH
  NATCASH
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Payment {
  id            String        @id @default(uuid())
  number        String        @unique
  client        Client        @relation(fields: [clientId], references: [id])
  clientId      String
  order         Order?        @relation(fields: [orderId], references: [id])
  orderId       String?
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("HTG")
  method        PaymentMethod
  status        PaymentStatus @default(CONFIRMED)
  reference     String?
  createdAt     DateTime      @default(now())

  @@index([status])
  @@index([clientId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  CANCELLED
}

model Invoice {
  id           String        @id @default(uuid())
  number       String        @unique
  client       Client        @relation(fields: [clientId], references: [id])
  clientId     String
  order        Order?        @relation(fields: [orderId], references: [id])
  orderId      String?
  subtotal     Decimal       @db.Decimal(12, 2)
  discount     Decimal       @default(0) @db.Decimal(12, 2)
  total        Decimal       @db.Decimal(12, 2)
  amountPaid   Decimal       @default(0) @db.Decimal(12, 2)
  status       InvoiceStatus @default(DRAFT)
  issuedAt     DateTime      @default(now())
  dueDate      DateTime?

  @@index([status])
}

// ==========================================================
// DOCUMENTS
// ==========================================================

enum DocumentType {
  CLIENT
  COMPANY
  CONTRACT
  INVOICE
  WORK_FILE
  FINAL_DELIVERABLE
}

model Document {
  id           String       @id @default(uuid())
  name         String
  type         DocumentType
  mimeType     String
  sizeBytes    Int
  storageKey   String       // chemin/objet dans le driver de stockage (local ou S3)
  client       Client?      @relation(fields: [clientId], references: [id])
  clientId     String?
  order        Order?       @relation(fields: [orderId], references: [id])
  orderId      String?
  request      Request?     @relation(fields: [requestId], references: [id])
  requestId    String?
  uploadedBy   Profile      @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  uploadedById String
  isPrivate    Boolean      @default(true)
  createdAt    DateTime     @default(now())

  @@index([clientId])
  @@index([orderId])
}

// ==========================================================
// TACHES
// ==========================================================

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  assignee    Profile?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assigneeId  String?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  order       Order?     @relation(fields: [orderId], references: [id])
  orderId     String?
  client      Client?    @relation(fields: [clientId], references: [id])
  clientId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
}

// ==========================================================
// NOTIFICATIONS
// ==========================================================

enum NotificationType {
  NEW_REQUEST
  NEW_PAYMENT
  URGENT_ORDER
  DOCUMENT_ADDED
  TASK_ASSIGNED
  ORDER_COMPLETED
  NEW_MESSAGE
}

model Notification {
  id         String           @id @default(uuid())
  profile    Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  type       NotificationType
  title      String
  body       String?
  link       String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([profileId, readAt])
}

// ==========================================================
// MESSAGES (structure prete, chat temps reel a ajouter plus tard)
// ==========================================================

model Conversation {
  id           String                     @id @default(uuid())
  subject      String?
  client       Client?                    @relation(fields: [clientId], references: [id])
  clientId     String?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  profile        Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId      String

  @@unique([conversationId, profileId])
}

model Message {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         Profile      @relation("MessageSender", fields: [senderId], references: [id])
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

// ==========================================================
// AUDIT LOGS
// ==========================================================

model AuditLog {
  id         String   @id @default(uuid())
  profile    Profile? @relation(fields: [profileId], references: [id])
  profileId  String?
  action     String
  module     String
  targetId   String?
  ip         String?
  result     String   @default("SUCCESS")
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([module])
  @@index([createdAt])
}

// ==========================================================
// SETTINGS
// ==========================================================

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
