// =========================================================
// ODTHAN — Schéma Prisma complet
// Une seule base PostgreSQL partagée par tous les modules.
// =========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// 1. UTILISATEURS / AUTH / RBAC
// =========================================================

enum RoleName {
  USER
  CLIENT
  AFFILIATE
  INVESTOR
  PARTNER
  ADMIN
  SUPER_ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?
  passwordHash  String
  emailVerified DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile   Profile?
  roles     UserRole[]
  sessions  Session[]

  businessProjects  BusinessProject[]
  affiliate         Affiliate?
  investments       Investment[]
  autoLeads         AutoLead[]
  notifications     Notification[]
  documents         Document[]
  payments          Payment[]
  messagesSent      Message[]        @relation("MessageSender")
  contactRequests   ContactRequest[]
  auditLogs         AuditLog[]

  @@index([email])
  @@index([createdAt])
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  firstName String
  lastName  String
  avatarUrl String?
  country   String?
  city      String?
  language  String   @default("fr")
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id          String     @id @default(cuid())
  name        RoleName   @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime   @default(now())
}

model Permission {
  id          String            @id @default(cuid())
  key         String            @unique // ex: "business.project.approve"
  description String?
  roles       RolePermission[]
  createdAt   DateTime          @default(now())
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// =========================================================
// 2. ODTHAN BUSINESS
// =========================================================

enum BusinessProjectStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model BusinessProject {
  id            String                @id @default(cuid())
  userId        String
  ideaTitle     String
  sector        String
  desiredName   String
  founderInfo   Json
  companyInfo   Json?
  budgetRange   String?
  contactPhone  String
  contactEmail  String
  status        BusinessProjectStatus @default(DRAFT)
  progress      Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  user     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  services BusinessProjectService[]
  documents Document[]
  payments  Payment[]
  messages  Message[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model BusinessService {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD")
  active      Boolean  @default(true)
  order       Int      @default(0)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects BusinessProjectService[]

  @@index([slug])
  @@index([active])
}

model BusinessProjectService {
  projectId String
  serviceId String

  project BusinessProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service BusinessService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([projectId, serviceId])
}

// =========================================================
// 3. ODTHAN AUTO — Marketplace & Affiliation
// =========================================================

model VehicleBrand {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  logoUrl   String?
  createdAt DateTime  @default(now())

  vehicles Vehicle[]

  @@index([slug])
}

model Vehicle {
  id           String   @id @default(cuid())
  brandId      String
  name         String
  slug         String   @unique
  year         Int
  price        Decimal  @db.Decimal(12, 2)
  currency     String   @default("USD")
  mileage      Int
  fuel         String
  transmission String
  bodyType     String
  location     String
  country      String
  description  String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  brand         VehicleBrand      @relation(fields: [brandId], references: [id])
  images        VehicleImage[]
  partners      VehiclePartner[]
  affiliateClicks AffiliateClick[]
  leads         AutoLead[]

  @@index([slug])
  @@index([brandId])
  @@index([active])
  @@index([createdAt])
}

model VehicleImage {
  id        String   @id @default(cuid())
  vehicleId String
  url       String
  altText   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model VehiclePartner {
  id        String   @id @default(cuid())
  vehicleId String
  name      String
  phone     String?
  email     String?
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model Affiliate {
  id        String   @id @default(cuid())
  userId    String   @unique
  code      String   @unique // ex: ODTHAN-AUTO-001
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicks  AffiliateClick[]
  leads   AutoLead[]
  commissions Commission[]

  @@index([code])
}

model AffiliateClick {
  id          String   @id @default(cuid())
  affiliateId String
  vehicleId   String?
  sessionId   String
  userId      String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  vehicle   Vehicle?  @relation(fields: [vehicleId], references: [id])

  @@index([affiliateId])
  @@index([vehicleId])
  @@index([sessionId])
  @@index([createdAt])
}

enum AutoLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTED
  WON
  LOST
}

model AutoLead {
  id          String         @id @default(cuid())
  userId      String?
  affiliateId String?
  vehicleId   String
  name        String
  phone       String
  email       String?
  message     String?
  status      AutoLeadStatus @default(NEW)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user       User?       @relation(fields: [userId], references: [id])
  affiliate  Affiliate?  @relation(fields: [affiliateId], references: [id])
  vehicle    Vehicle     @relation(fields: [vehicleId], references: [id])
  commission Commission?

  @@index([affiliateId])
  @@index([vehicleId])
  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model Commission {
  id          String            @id @default(cuid())
  affiliateId String
  leadId      String            @unique
  amount      Decimal           @db.Decimal(10, 2)
  currency    String            @default("USD")
  status      CommissionStatus  @default(PENDING)
  createdAt   DateTime          @default(now())
  paidAt      DateTime?

  affiliate Affiliate @relation(fields: [affiliateId], references: [id])
  lead      AutoLead  @relation(fields: [leadId], references: [id])

  @@index([affiliateId])
  @@index([status])
}

// =========================================================
// 4. ODTHAN INVESTIR
// =========================================================

model InvestmentOpportunity {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  minimum     Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD")
  termMonths  Int
  target      Decimal  @db.Decimal(14, 2)
  active      Boolean  @default(false) // désactivée par défaut — validation admin requise
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  investments Investment[]

  @@index([slug])
  @@index([active])
}

enum InvestmentStatus {
  REQUESTED
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

model Investment {
  id            String           @id @default(cuid())
  userId        String
  opportunityId String
  amount        Decimal          @db.Decimal(14, 2)
  currency      String           @default("USD")
  status        InvestmentStatus @default(REQUESTED)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user         User                   @relation(fields: [userId], references: [id])
  opportunity  InvestmentOpportunity  @relation(fields: [opportunityId], references: [id])
  transactions InvestmentTransaction[]

  @@index([userId])
  @@index([opportunityId])
  @@index([status])
}

model InvestmentTransaction {
  id           String   @id @default(cuid())
  investmentId String
  amount       Decimal  @db.Decimal(14, 2)
  currency     String   @default("USD")
  type         String   // DEPOSIT, PAYOUT, ADJUSTMENT
  createdAt    DateTime @default(now())

  investment Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([investmentId])
}

// =========================================================
// 5. PAIEMENTS / FACTURATION
// =========================================================

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  businessProjectId String?
  provider          String        // paypal, stripe, manual
  providerRef       String?
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("USD")
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  businessProject BusinessProject? @relation(fields: [businessProjectId], references: [id])
  invoice         Invoice?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Invoice {
  id        String   @id @default(cuid())
  paymentId String   @unique
  number    String   @unique
  pdfUrl    String?
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

// =========================================================
// 6. DOCUMENTS / NOTIFICATIONS / MESSAGES
// =========================================================

model Document {
  id                String   @id @default(cuid())
  userId            String
  businessProjectId String?
  name              String
  storageKey        String   // clé privée S3, jamais une URL publique permanente
  mimeType          String
  sizeBytes         Int
  createdAt         DateTime @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessProject BusinessProject? @relation(fields: [businessProjectId], references: [id])

  @@index([userId])
  @@index([businessProjectId])
}

enum NotificationType {
  EMAIL
  WHATSAPP
  IN_APP
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Message {
  id                String   @id @default(cuid())
  senderId          String
  businessProjectId String?
  content           String
  createdAt         DateTime @default(now())

  sender          User             @relation("MessageSender", fields: [senderId], references: [id])
  businessProject BusinessProject? @relation(fields: [businessProjectId], references: [id])

  @@index([businessProjectId])
}

// =========================================================
// 7. CONTENU (Blog / FAQ / Témoignages)
// =========================================================

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String
  content         String
  imageUrl        String?
  seoTitle        String?
  seoDescription  String?
  published       Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([slug])
  @@index([published])
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("general")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  authorName String
  role       String?
  content    String
  rating     Int      @default(5)
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model ContactRequest {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  email     String
  subject   String
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([handled])
}

// =========================================================
// 8. AUDIT / PARAMÈTRES
// =========================================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value Json

  @@index([key])
}
